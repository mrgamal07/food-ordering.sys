@model IEnumerable<FoodCategory>
@{ ViewData["Title"] = "Categories"; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><div class="section-kicker">BACK OF HOUSE</div><h1 class="section-title mt-2 mb-0">Categories.</h1></div></div><div class="admin-nav mb-4"><a asp-action="Index">Overview</a><a asp-action="Foods">Menu items</a><a asp-action="Categories">Categories</a><a asp-action="Orders">Orders</a><a asp-action="Inventory">Inventory</a><a asp-action="SoldItems">Sold items</a></div><div class="panel mb-4"><h2 class="h5">Add category</h2><form asp-action="SaveCategory" method="post" class="row g-3"><div class="col-md-4"><label class="form-label">Name</label><input name="Name" class="form-control" required /></div><div class="col-md-6"><label class="form-label">Description</label><input name="Description" class="form-control" /></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-dark rounded-pill w-100">Save</button></div></form></div><div class="row g-3">@foreach (var category in Model) { <div class="col-md-6"><div class="order-card"><div class="d-flex justify-content-between"><div><h3 class="h5 mb-1">@category.Name</h3><p class="muted small mb-0">@category.Description</p></div><span class="status-chip">@category.Foods.Count items</span></div></div></div> }</div>
