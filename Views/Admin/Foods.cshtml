@model IEnumerable<Food>
@{ ViewData["Title"] = "Menu items"; var categories = ViewBag.Categories as IEnumerable<FoodCategory> ?? []; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><div class="section-kicker">BACK OF HOUSE</div><h1 class="section-title mt-2 mb-0">Menu items.</h1></div><button class="btn btn-coral rounded-pill" data-bs-toggle="collapse" data-bs-target="#foodForm">+ Add item</button></div><div class="admin-nav mb-4"><a asp-action="Index">Overview</a><a asp-action="Foods">Menu items</a><a asp-action="Categories">Categories</a><a asp-action="Orders">Orders</a><a asp-action="Inventory">Inventory</a><a asp-action="SoldItems">Sold items</a></div>
<div class="collapse mb-4" id="foodForm"><div class="panel"><h2 class="h5">Add a menu item</h2><form asp-action="SaveFood" method="post" class="row g-3"><div class="col-md-6"><label class="form-label">Name</label><input name="Name" class="form-control" required /></div><div class="col-md-3"><label class="form-label">Category</label><select name="FoodCategoryId" class="form-select">@foreach (var c in categories) { <option value="@c.FoodCategoryId">@c.Name</option> }</select></div><div class="col-md-3"><label class="form-label">Price (Rs.)</label><input name="Price" type="number" step="0.01" class="form-control" required /></div><div class="col-md-8"><label class="form-label">Description</label><input name="Description" class="form-control" /></div><div class="col-md-2"><label class="form-label">Stock</label><input name="StockQuantity" type="number" class="form-control" value="40" /></div><div class="col-md-2"><label class="form-label">Reorder at</label><input name="ReorderLevel" type="number" class="form-control" value="10" /></div><div class="col-12"><button class="btn btn-dark rounded-pill px-4">Save item</button></div></form></div></div>
<div class="table-shell"><table class="table"><thead><tr><th>Dish</th><th>Category</th><th>Price</th><th>Stock</th><th>Availability</th><th></th></tr></thead><tbody>@foreach (var food in Model) { <tr><td><strong>@food.Name</strong><div class="muted small">@food.Description</div></td><td>@food.Category.Name</td><td>Rs. @food.Price.ToString("N0")</td><td>@food.Inventory?.QuantityInStock</td><td>@(food.IsAvailable ? "Available" : "Hidden")</td><td><form asp-action="ToggleFood" method="post"><input type="hidden" name="id" value="@food.FoodId" /><button class="btn btn-sm btn-outline-dark rounded-pill">@(food.IsAvailable ? "Hide" : "Show")</button></form></td></tr> }</tbody></table></div>
