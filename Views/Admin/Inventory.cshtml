@model IEnumerable<Inventory>
@{ ViewData["Title"] = "Inventory"; }
<div class="section-kicker">BACK OF HOUSE</div><h1 class="section-title mt-2 mb-4">Inventory.</h1><div class="admin-nav mb-4"><a asp-action="Index">Overview</a><a asp-action="Foods">Menu items</a><a asp-action="Categories">Categories</a><a asp-action="Orders">Orders</a><a asp-action="Inventory">Inventory</a><a asp-action="SoldItems">Sold items</a></div><div class="table-shell"><table class="table"><thead><tr><th>Item</th><th>Current stock</th><th>Reorder level</th><th>Updated</th><th></th></tr></thead><tbody>@foreach (var item in Model) { var low = item.QuantityInStock <= item.ReorderLevel; <tr><td><strong>@item.Food.Name</strong></td><td><span class="@(low ? "text-danger fw-bold" : "")">@item.QuantityInStock units</span></td><td>@item.ReorderLevel</td><td class="muted small">@item.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><form asp-action="UpdateInventory" method="post" class="d-flex gap-2 justify-content-end"><input type="hidden" name="id" value="@item.InventoryId" /><input class="form-control form-control-sm" style="width:80px" type="number" name="quantity" value="@item.QuantityInStock" min="0" /><input class="form-control form-control-sm" style="width:80px" type="number" name="reorderLevel" value="@item.ReorderLevel" min="0" /><button class="btn btn-sm btn-dark rounded-pill">Update</button></form></td></tr> }</tbody></table></div>
