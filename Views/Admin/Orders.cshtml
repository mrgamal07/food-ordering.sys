@model IEnumerable<Order>
@{ ViewData["Title"] = "Orders"; var statuses = new[] { "Confirmed", "Preparing", "Out for delivery", "Delivered", "Cancelled" }; }
<div class="section-kicker">BACK OF HOUSE</div><h1 class="section-title mt-2 mb-4">Orders.</h1><div class="admin-nav mb-4"><a asp-action="Index">Overview</a><a asp-action="Foods">Menu items</a><a asp-action="Categories">Categories</a><a asp-action="Orders">Orders</a><a asp-action="Inventory">Inventory</a><a asp-action="SoldItems">Sold items</a></div><div class="table-shell"><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Placed</th><th>Total</th><th>Payment</th><th>Fulfillment</th></tr></thead><tbody>@foreach (var order in Model) { <tr><td><strong>#@order.OrderId.ToString("D4")</strong><div class="muted small">@order.DeliveryAddress</div></td><td>@order.Customer.FullName<br /><span class="muted small">@order.Customer.Phone</span></td><td>@order.OrderDate.ToLocalTime().ToString("dd MMM, h:mm tt")</td><td>Rs. @order.TotalAmount.ToString("N0")</td><td><span class="status-chip @(order.PaymentStatus == "Failed" ? "failed" : "")">@order.PaymentStatus</span><br /><span class="muted small">@order.PaymentMethod</span></td><td><form asp-action="UpdateOrder" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@order.OrderId" /><select name="status" class="form-select form-select-sm">@foreach (var status in statuses) { <option selected="@(status == order.Status)" value="@status">@status</option> }</select><button class="btn btn-sm btn-dark rounded-pill">Save</button></form></td></tr> }</tbody></table></div>
