@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin dashboard"; }
<div class="dashboard-hero mb-4"><div class="section-kicker text-warning">BACK OF HOUSE</div><h1 class="mt-2 mb-2">Good morning, chef.</h1><p class="mb-0 opacity-75">A clear view of today's service, stock, and orders.</p></div>
<div class="admin-nav mb-4"><a asp-action="Index">Overview</a><a asp-action="Foods">Menu items</a><a asp-action="Categories">Categories</a><a asp-action="Orders">Orders</a><a asp-action="Inventory">Inventory</a><a asp-action="SoldItems">Sold items</a></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="stat-card"><div class="label">Today's orders</div><div class="value">@Model.TodayOrders</div></div></div><div class="col-md-3"><div class="stat-card"><div class="label">Today's revenue</div><div class="value">Rs. @Model.TodayRevenue.ToString("N0")</div></div></div><div class="col-md-3"><div class="stat-card"><div class="label">Menu items</div><div class="value">@Model.TotalFoods</div></div></div><div class="col-md-3"><div class="stat-card"><div class="label">Low stock</div><div class="value text-danger">@Model.LowStockItems</div></div></div></div>
<div class="row g-4"><div class="col-lg-8"><div class="panel"><div class="d-flex justify-content-between mb-3"><h2 class="h5 mb-0">Recent orders</h2><a class="small muted" asp-action="Orders">View all →</a></div><div class="table-shell"><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th></tr></thead><tbody>@foreach (var order in Model.RecentOrders) { <tr><td>#@order.OrderId.ToString("D4")</td><td>@order.Customer.FullName</td><td><span class="status-chip">@order.Status</span></td><td>Rs. @order.TotalAmount.ToString("N0")</td></tr> }</tbody></table></div></div></div><div class="col-lg-4"><div class="panel"><h2 class="h5 mb-3">Stock watch</h2>@foreach (var item in Model.LowStock) { <div class="d-flex justify-content-between border-bottom py-2"><span>@item.Food.Name</span><strong class="text-danger">@item.QuantityInStock left</strong></div> } @if (!Model.LowStock.Any()) { <p class="muted small">All stocked up.</p> }</div></div></div>

