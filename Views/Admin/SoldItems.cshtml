@model IEnumerable<SoldItem>
@{ ViewData["Title"] = "Sold items"; }
<div class="section-kicker">BACK OF HOUSE</div><h1 class="section-title mt-2 mb-4">Sold items.</h1><div class="admin-nav mb-4"><a asp-action="Index">Overview</a><a asp-action="Foods">Menu items</a><a asp-action="Categories">Categories</a><a asp-action="Orders">Orders</a><a asp-action="Inventory">Inventory</a><a asp-action="SoldItems">Sold items</a></div><div class="d-flex gap-3 mb-4"><div class="stat-card"><div class="label">Units sold</div><div class="value">@Model.Sum(x => x.Quantity)</div></div><div class="stat-card"><div class="label">Recorded revenue</div><div class="value">Rs. @Model.Sum(x => x.TotalAmount).ToString("N0")</div></div></div><div class="table-shell"><table class="table"><thead><tr><th>Dish</th><th>Order</th><th>Quantity</th><th>Unit price</th><th>Total</th><th>Sold at</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Food.Name</td><td>#@item.OrderId.ToString("D4")</td><td>@item.Quantity</td><td>Rs. @item.UnitPrice.ToString("N0")</td><td><strong>Rs. @item.TotalAmount.ToString("N0")</strong></td><td class="muted small">@item.SoldAt.ToLocalTime().ToString("dd MMM yyyy · h:mm tt")</td></tr> }</tbody></table></div>
