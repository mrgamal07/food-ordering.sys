@model Food
@{ ViewData["Title"] = Model.Name; }
<div class="row g-5 align-items-center py-4"><div class="col-lg-6"><img src="@(Model.ImageUrl ?? "/images/hero-food.jpg")" class="w-100 rounded-4" style="height:430px;object-fit:cover" alt="@Model.Name" /></div><div class="col-lg-6"><div class="section-kicker">@Model.Category.Name.ToUpperInvariant()</div><h1 class="section-title mt-2">@Model.Name</h1><p class="muted my-3" style="font-size:1.1rem;line-height:1.7">@Model.Description</p><div class="food-price fs-4 mb-4">Rs. @Model.Price.ToString("N0")</div><form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2"><input type="hidden" name="foodId" value="@Model.FoodId" /><input class="form-control" name="quantity" type="number" min="1" max="10" value="1" style="max-width:100px" /><button class="btn btn-coral rounded-pill px-4" type="submit">Add to order +</button></form><a class="d-inline-block mt-4 muted small" asp-action="Index">← Back to menu</a></div></div>
