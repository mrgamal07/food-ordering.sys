@model CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }
<div class="row justify-content-center"><div class="col-lg-8"><div class="section-kicker">ALMOST THERE</div><h1 class="section-title mt-2">Checkout.</h1><p class="muted mb-4">Tell us where to bring the good stuff.</p><div class="auth-card"><form asp-action="Checkout" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="mb-4"><label asp-for="DeliveryAddress" class="form-label"></label><textarea asp-for="DeliveryAddress" class="form-control" rows="3" placeholder="House, street, landmark"></textarea><span asp-validation-for="DeliveryAddress" class="text-danger small"></span></div><div class="mb-4"><label asp-for="PaymentMethod" class="form-label">How would you like to pay?</label><div class="row g-2"><div class="col-md-4"><input class="btn-check" type="radio" asp-for="PaymentMethod" value="Cash on Delivery" id="cash" checked><label class="btn btn-outline-dark w-100 py-3" for="cash">Cash on delivery</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="PaymentMethod" value="eSewa" id="esewa"><label class="btn btn-outline-dark w-100 py-3" for="esewa">eSewa</label></div><div class="col-md-4"><input class="btn-check" type="radio" asp-for="PaymentMethod" value="Khalti" id="khalti"><label class="btn btn-outline-dark w-100 py-3" for="khalti">Khalti</label></div></div></div><button class="btn btn-coral rounded-pill w-100 py-2" type="submit">Place order <span>→</span></button></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
