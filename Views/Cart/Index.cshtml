@model CartViewModel
@{ ViewData["Title"] = "Your cart"; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><div class="section-kicker">YOUR TABLE</div><h1 class="section-title mt-2 mb-0">Your order.</h1></div><a asp-controller="Home" asp-action="Index" class="muted small">← Keep browsing</a></div>
@if (!Model.Lines.Any()) { <div class="empty-state text-center py-5"><h2 class="h3">Your cart is waiting for a good idea.</h2><p class="muted">Browse the menu and add something made to share.</p><a asp-controller="Home" asp-action="Index" class="btn btn-coral rounded-pill px-4">Browse menu</a></div> } else { <div class="row g-4 align-items-start"><div class="col-lg-8">@foreach (var line in Model.Lines) { <div class="order-card mb-3 d-flex gap-3 align-items-center"><img src="@(line.Food.ImageUrl ?? "/images/hero-food.jpg")" style="width:84px;height:84px;object-fit:cover;border-radius:12px" alt="@line.Food.Name" /><div class="flex-grow-1"><h3 class="h5 mb-1">@line.Food.Name</h3><div class="muted small">Rs. @line.Food.Price.ToString("N0") each</div></div><form asp-action="Update" method="post" class="d-flex align-items-center gap-2"><input type="hidden" name="foodId" value="@line.Food.FoodId" /><input class="form-control form-control-sm" style="width:70px" type="number" name="quantity" min="0" max="99" value="@line.Quantity" /><button class="btn btn-sm btn-outline-dark rounded-pill" type="submit">Update</button></form><strong>Rs. @line.LineTotal.ToString("N0")</strong><form asp-action="Remove" method="post"><input type="hidden" name="foodId" value="@line.Food.FoodId" /><button class="btn btn-link text-danger p-0" type="submit" title="Remove">×</button></form></div> }</div><div class="col-lg-4"><div class="panel"><div class="d-flex justify-content-between mb-2"><span class="muted">Subtotal</span><strong>Rs. @Model.Total.ToString("N0")</strong></div><div class="d-flex justify-content-between mb-3"><span class="muted">Delivery</span><span>Calculated at checkout</span></div><hr /><div class="d-flex justify-content-between mb-4"><strong>Total</strong><strong class="food-price fs-5">Rs. @Model.Total.ToString("N0")</strong></div>@if (User.IsInRole("Customer")) { <a asp-action="Checkout" class="btn btn-coral rounded-pill w-100 py-2">Continue to checkout</a> } else { <a asp-controller="Auth" asp-action="Login" class="btn btn-dark rounded-pill w-100 py-2">Sign in to checkout</a> }<p class="muted small mt-3 mb-0">We accept cash on delivery, eSewa, and Khalti.</p></div></div></div> }
