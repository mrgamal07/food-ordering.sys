@using SingleRestaurantOrdering.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Thali & Spice</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container py-2">
            <a class="navbar-brand brand-lockup" asp-controller="Home" asp-action="Index"><span class="brand-mark">T</span><span>THALI <em>&</em> SPICE</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                    <li><a class="nav-link" asp-controller="Home" asp-action="Index">Menu</a></li>
                    @if (User.IsInRole("Customer")) { <li><a class="nav-link" asp-controller="Orders" asp-action="Index">My orders</a></li> }
                    @if (User.IsInRole("Admin")) { <li><a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a></li> }
                    <li><a class="nav-link cart-link" asp-controller="Cart" asp-action="Index">Cart <span class="cart-dot">@CartSession.Get(Context).Values.Sum()</span></a></li>
                    @if (User.Identity?.IsAuthenticated == true) { <li><form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-link nav-link px-0" type="submit">Sign out</button></form></li> }
                    else { <li><a class="nav-link fw-bold" asp-controller="Auth" asp-action="Register">Register</a></li><li><a class="btn btn-dark rounded-pill px-4" asp-controller="Auth" asp-action="Login">Sign in</a></li> }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container py-4">
    @if (TempData["Toast"] is string toast) { <div class="alert toast-alert">@toast</div> }
    @if (TempData["PaymentError"] is string paymentError) { <div class="alert alert-warning">@paymentError</div> }
    <main role="main">@RenderBody()</main>
</div>
<footer class="site-footer mt-5"><div class="container d-flex justify-content-between flex-wrap gap-2"><span>© 2026 Thali & Spice</span><span>Made for slow meals and good company.</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
