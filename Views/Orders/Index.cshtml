@model IEnumerable<Order>
@{ ViewData["Title"] = "My orders"; }

<div class="section-kicker">YOUR HISTORY</div>
<h1 class="section-title mt-2 mb-4">My orders.</h1>

@if (!Model.Any())
{
    <div class="empty-state">
        <h2 class="h4">No orders yet.</h2>
        <p class="muted">Your first plate is the best one.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-coral rounded-pill">Browse menu</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var order in Model)
        {
            <div class="col-md-6">
                <a class="order-card d-block" asp-action="Details" asp-route-id="@order.OrderId">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>Order #@order.OrderId.ToString("D4")</strong>
                            <div class="muted small mt-1">@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy · h:mm tt")</div>
                        </div>
                        <span class="status-chip @(order.PaymentStatus == "Failed" ? "failed" : order.Status == "Pending" ? "pending" : "")">@order.Status</span>
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <span class="muted">@order.Details.Sum(x => x.Quantity) items · @order.PaymentMethod</span>
                        <strong class="food-price">Rs. @order.TotalAmount.ToString("N0")</strong>
                    </div>
                    @if (order.PaymentStatus == "Paid")
                    {
                        <div class="small text-success fw-semibold mt-3">Payment completed · No further payment required</div>
                    }
                    else
                    {
                        <div class="small @(order.PaymentStatus == "Failed" ? "text-danger" : "muted") mt-3">Payment: @order.PaymentStatus</div>
                    }
                </a>
            </div>
        }
    </div>
}
